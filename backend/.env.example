# Backend settings. Copy to .env for your PC:  copy .env.example .env
# NEVER commit .env (it is in .gitignore). On Render, add these in the service's "Environment" tab.

# --- Database ------------------------------------------------------------------------------
# Leave DATABASE_URL empty to keep analyses in memory only (fine for trying the app on your PC).
#
# Local database (Docker Desktop):  docker compose up -d   then   npm run db:deploy --workspace backend
# DATABASE_URL="postgresql://pg:pg@localhost:5434/pgselector?schema=superpave"
# DIRECT_URL="postgresql://pg:pg@localhost:5434/pgselector?schema=superpave"
#
# Supabase (Project -> Connect -> "Session pooler"), the same project as the AASHTO app.
# Keep ?schema=superpave at the end: this app then uses its own schema and never touches the other app's tables.
# DATABASE_URL="postgresql://postgres.<project-ref>:<db-password>@aws-0-<region>.pooler.supabase.com:5432/postgres?schema=superpave"
# DIRECT_URL="postgresql://postgres.<project-ref>:<db-password>@aws-0-<region>.pooler.supabase.com:5432/postgres?schema=superpave"
DATABASE_URL=""
DIRECT_URL=""

# --- Accounts -------------------------------------------------------------------------------
# Key that signs log-in tokens (at least 16 random characters). If empty: derived from DATABASE_URL, or random
# when there is no database (then log-ins end when the API restarts).
JWT_SECRET=""

# --- HTTP ------------------------------------------------------------------------------------
# Browser addresses allowed to call the API ("*" wildcards allowed, e.g. Vercel previews).
CORS_ORIGINS="http://localhost:3100"
# Render sets PORT itself. On your PC the API runs on 4100 (the AASHTO app uses 4000).
PORT=4100
